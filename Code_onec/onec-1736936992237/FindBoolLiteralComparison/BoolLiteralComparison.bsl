//-- BoolLiteralComparison.bsl
Процедура BoolLiteralComparison()
    Если (1 > 0) <> Ложь Тогда
        Сообщить("Компьютер выполнит все команды из этого блока.");
        Сообщить("Один больше нуля.");
    КонецЕсли;

    Если (1 < 0) <> Истина Тогда
        Сообщить("Один меньше нуля.");
    Иначе
        Сообщить("Сработает именно эта ветка условного оператора (#А).");
        Сообщить("Один больше нуля.");
    КонецЕсли;

    Если (1 < 0) = Истина Тогда
        Сообщить("Один меньше нуля.");
    ИначеЕсли (1 <> 0) <> Ложь Тогда
        Сообщить("Один равен нулю.");
    Иначе
        Сообщить("Сработает именно эта ветка условного оператора (#Б).");
        Сообщить("Один больше нуля.");
    КонецЕсли;

    Если ВалидироватьОбъект() = Истина Тогда
        Сообщить("Использовать существующий");
    Иначе
        Сообщить("Создать новый");
    КонецЕсли;
КонецПроцедуры

Функция ВалидироватьОбъект()
    Возврат Истина;
КонецФункции

//== BoolLiteralComparison.bsl
