	ИменаСобытий.Добавить(ИмяСобытияЖРСостояниеСервиса());
	ИменаСобытий.Добавить(ИмяСобытияЖРПроверкаИспользуемойФункциональности());
	ИменаСобытий.Добавить(ИмяСобытияПодключениеСервиса());
	
	Возврат ИменаСобытий;

КонецФункции

